# Tollgate — Environment Variables
PORT=8000
DYNAMODB_ENDPOINT=http://dynamodb:8000
AWS_REGION=ap-northeast-1
DYNAMODB_TABLE_NAME=TollgateAPIKeys
# OPENAPI_PATH=/openapi.json # OpenAPI 3.1 仕様スキーマのパスマッピング (未指定または空文字で無効化)
# DOCS_PATH=/docs # Scalar ドキュメント UI のパスマッピング (未指定または空文字で無効化)
# KEY_CACHE_TTL=10 # API キー検証キャッシュ TTL 秒 (0 で無効化)
ADMIN_API_KEY=admin-secret-key-for-local-dev # 管理用 WebAPI (/v1/admin/...) 用のマスターキー

# データベースバックエンド: dynamodb (default) | sqlite | cosmosdb | firestore
# STORAGE_BACKEND=dynamodb
# SQLITE_PATH=./tollgate.db
# COSMOSDB_ENDPOINT=https://<your-account>.documents.azure.com:443/
# COSMOSDB_KEY=<your-primary-or-secondary-key>
# COSMOSDB_DATABASE=tollgate
# COSMOSDB_CONTAINER=api_keys
# FIRESTORE_PROJECT_ID=<your-gcp-project-id>
# FIRESTORE_DATABASE_ID=(default)
# FIRESTORE_COLLECTION=api_keys

# レートリミットバックエンド: memory (default) | redis (valkey) | two-tier | dynamodb
# (※ STORAGE_BACKEND=sqlite の場合は自動的に memory に固定されます)
# (※ two-tier は L1 ローカルインメモリ + L2 Redis/Valkey の2段キャッシュ構成です)
# RATE_LIMIT_BACKEND=memory

# Redis / Valkey 接続設定 (RATE_LIMIT_BACKEND=redis / valkey / two-tier 時のみ使用)
# VALKEY_URL=redis://localhost:6379/0  # URL指定（REDIS_URL も可、個別指定より優先）
# REDIS_ADDR=redis:6379
# REDIS_PASSWORD=
# REDIS_DB=0


# ─────────────────────────────────────────────────────────────────────────────
# リバースプロキシ設定 (JSON 環境変数 または 設定ファイルで指定)
# ─────────────────────────────────────────────────────────────────────────────
# 動的マルチターゲット・ルーティング (JSON 配列文字列)
PROXY_ROUTES=[{"prefix":"/users","target":"http://users-service:8000","scope":"users:*","strip_prefix":true},{"prefix":"/billing","target":"http://billing-service:8000","scope":"billing:*","strip_prefix":true},{"prefix":"/analytics","target":"http://analytics-service:8000","scope":"analytics:*","strip_prefix":true}]

# または設定ファイルパスによる指定 (ROUTES_CONFIG_FILE)
# ROUTES_CONFIG_FILE=./routes.json

# 未マッチ時のデフォルトフォールバック先 (未指定時は 404)
# FORWARD_TARGET_URL=http://webapi:8000

OPENAPI_PATH=/openapi.json
DOCS_PATH=/docs
